# 合并到当前生效的环境文件；不要覆盖现有应用凭据。
# DRIVER 按现有配置保留；WebSocket 连接需要相应驱动。
DRIVER=~fastapi+~httpx+~websockets
COMMAND_START=["/"]
SUPERUSERS=["qq:替换为vf身份返回的用户OpenID"]
QQ_BOTS=[{"id":"你的应用ID","secret":"你的应用Secret","intent":{"c2c_group_at_messages":true,"at_messages":true,"direct_message":true}}]

CHAT_API_KEY=你的模型密钥
CHAT_API_URL=https://api.deepseek.com
CHAT_MODEL_NAME=deepseek-v4-flash-vision-exp
# 思考开关和等级独立配置，修改后重启生效
CHAT_THINKING_ENABLED=false
# low / high / max，仅开启思考时生效
CHAT_REASONING_EFFORT=high
EMBEDDING_API_KEY=你的向量模型密钥
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# RERANKER_API_KEY=
# RERANKER_API_URL=https://api.siliconflow.cn/v1/rerank
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Qwen TTS：独立配置百炼密钥与已创建的复刻音色
TTS_API_KEY=你的百炼密钥
TTS_VOICE_ID=你的复刻音色ID
TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
